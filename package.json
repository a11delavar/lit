{
	"type": "module",
	"scripts": {
		"dev": "vitest --project chromium",
		"test": "vitest run",
		"lint": "eslint \"**/*.ts\"",
		"typescript": "npm run clean && tsgo --build --noEmit && tsgo -p packages/tsconfig.json",
		"clean": "node ./scripts/clean.ts",
		"bump": "node ./scripts/bump.ts",
		"release": "node ./scripts/release.ts",
		"changelog": "node ./scripts/changelog.ts",
		"readme": "node ./scripts/readme.ts",
		"docs:build": "node ./scripts/docs-build.ts"
	},
	"workspaces": [
		"./packages/*"
	],
	"devDependencies": {
		"@3mo/commit-analyzer": "x",
		"@a11d/eslint-config": "x",
		"@lit-labs/ssr-client": "1.x",
		"@types/node": "26.x",
		"@typescript/native-preview": "latest",
		"@vitest/browser-playwright": "5.x",
		"eslint": "x",
		"execa": "x",
		"playwright": "1.x",
		"tslib": "2.x",
		"typescript": "5.x",
		"vitest": "5.x"
	}
}
